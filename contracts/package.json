{
  "name": "throbbin-abbey-contracts",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "deploy:robinhoodTestnet": "hardhat run scripts/deploy.js --network robinhoodTestnet",
    "deploy:robinhood": "hardhat run scripts/deploy.js --network robinhood",
    "deploy:fuji": "hardhat run scripts/deploy.js --network fuji",
    "deploy:avalanche": "hardhat run scripts/deploy.js --network avalanche",
    "founder:robinhoodTestnet": "hardhat run scripts/founderMint.js --network robinhoodTestnet",
    "founder:robinhood": "hardhat run scripts/founderMint.js --network robinhood",
    "open:robinhoodTestnet": "MINT_OPEN=true hardhat run scripts/setMint.js --network robinhoodTestnet",
    "open:robinhood": "MINT_OPEN=true hardhat run scripts/setMint.js --network robinhood",
    "open:fuji": "MINT_OPEN=true hardhat run scripts/setMint.js --network fuji",
    "open:avalanche": "MINT_OPEN=true hardhat run scripts/setMint.js --network avalanche",
    "tolls:robinhoodTestnet": "hardhat run scripts/deployTolls.js --network robinhoodTestnet",
    "toll:robinhoodTestnet": "hardhat run scripts/setToll.js --network robinhoodTestnet",
    "tolls:robinhood": "hardhat run scripts/deployTolls.js --network robinhood",
    "toll:robinhood": "hardhat run scripts/setToll.js --network robinhood"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.10"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "dotenv": "^16.4.5"
  }
}
